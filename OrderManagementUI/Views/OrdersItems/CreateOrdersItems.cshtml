@model OrderManagementUI.ViewModels.OrderViewModel

@{
    ViewData["Title"] = "Create Orders with Items";

    // Alert messages
    if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
        </div>
    }

    if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
        </div>
    }

    if (TempData["WarningMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            @TempData["WarningMessage"]
        </div>
    }

    if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            @TempData["InfoMessage"]
        </div>
    }
}

<style>
    .alert {
        margin-top: 20px;
    }

    .alert-dismissible .close {
        position: relative;
        top: -2px;
        right: -10px;
    }
</style>

<h1>Create Orders with Items</h1>

<hr />
<form asp-action="CreateOrdersItems" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="Order.OrderNumber" class="control-label"></label>
        <input asp-for="Order.OrderNumber" class="form-control" />
        <span asp-validation-for="Order.OrderNumber" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Order.OrderDate" class="control-label"></label>
        <input asp-for="Order.OrderDate" class="form-control" type="date" />
        <span asp-validation-for="Order.OrderDate" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Order.CustomerName" class="control-label"></label>
        <input asp-for="Order.CustomerName" class="form-control" />
        <span asp-validation-for="Order.CustomerName" class="text-danger"></span>
    </div>

    <h3>Order Items</h3>

    <table id="orderItemsTable" class="table">
        <thead>
            <tr>
                <th>Product Name</th>
                <th>Quantity</th>
                <th>Price</th>
                <th>Product ID</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            <!-- Initial rows can be added here if needed -->
        </tbody>
    </table>

    <button type="button" class="btn btn-primary" id="addItemButton">Add Order Item</button>

    <div class="form-group mt-3">
        <input type="submit" value="Create Order" class="btn btn-success" />
    </div>
</form>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        var orderItemIndex = 0; // Initialize with 0

        // Add row for new order item
        document.getElementById("addItemButton").addEventListener("click", function () {
            var table = document.getElementById("orderItemsTable").getElementsByTagName('tbody')[0];
            var newRow = table.insertRow();

            var cell1 = newRow.insertCell(0);
            var cell2 = newRow.insertCell(1);
            var cell3 = newRow.insertCell(2);
            var cell4 = newRow.insertCell(3);
            var cell5 = newRow.insertCell(4);

            cell1.innerHTML = '<input type="text" name="Order.OrderItems[' + orderItemIndex + '].ProductName" class="form-control" />';
            cell2.innerHTML = '<input type="number" name="Order.OrderItems[' + orderItemIndex + '].Quantity" class="form-control" />';
            cell3.innerHTML = '<input type="number" name="Order.OrderItems[' + orderItemIndex + '].ProductPrice" class="form-control" />';
            cell4.innerHTML = '<input type="number" name="Order.OrderItems[' + orderItemIndex + '].ProductId" class="form-control" />';
            cell5.innerHTML = '<button type="button" class="btn btn-danger" onclick="removeRow(this)">Remove</button>';

            orderItemIndex++;
        });

        // Remove row
        function removeRow(button) {
            var row = button.closest('tr');
            row.remove();
        }
    </script>
}
