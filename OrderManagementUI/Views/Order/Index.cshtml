@model IEnumerable<OrderManagementUI.ViewModels.OrderViewModel>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
    <a asp-action="GetOrdersItems">View Orders</a>
    @Html.ActionLink("View Orders", "GetOrdersItems")
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Order.OrderId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Order.OrderNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Order.OrderDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Order.CustomerName)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null){
            foreach (var item in Model) {
                <tr>
                    <td>
                            @Html.DisplayFor(modelItem => item.Order.OrderId)
                    </td>
                    <td>
                            @Html.DisplayFor(modelItem => item.Order.OrderNumber)
                    </td>
                    <td>
                            @Html.DisplayFor(modelItem => item.Order.OrderDate, "{0:yyyy-MM-dd}", new { type = "date" })
                    </td>
                    <td>
                            @Html.DisplayFor(modelItem => item.Order.CustomerName)
                    </td>
                    <td>
                            @Html.ActionLink("Edit", "Edit", new { id = item.Order.OrderId }) |
                            @Html.ActionLink("Details", "Details", new { id = item.Order.OrderId }) |
                            @Html.ActionLink("Delete", "Delete", new { id = item.Order.OrderId })
                  
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
